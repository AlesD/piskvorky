<?xml version="1.0" encoding="UTF-8"?>
<!--
  With the gtp profile the process STDERR carries the GTP messages channel
  (Context.messages(), GoGui live graphics), so log lines must not pollute it:
  logging goes to the file only. Without the profile, console logging goes to
  STDERR because STDOUT may still be reserved for the protocol stream.
  File logging goes to the directory named by the `piskvorky.logs.dir` property
  (default "target/logs", relative to the working directory — the `piskvorky` launcher
  script pins it to the app module's target/logs).
-->
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<springProperty scope="context" name="LOG_DIR" source="piskvorky.logs.dir"
		defaultValue="target/logs"/>
	<springProfile name="!gtp">
		<appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
			<target>System.err</target>
			<encoder>
				<pattern>${CONSOLE_LOG_PATTERN}</pattern>
				<charset>${CONSOLE_LOG_CHARSET}</charset>
			</encoder>
		</appender>
	</springProfile>
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/piskvorky-app.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR}/piskvorky-app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxFileSize>10MB</maxFileSize>
			<maxHistory>14</maxHistory>
			<totalSizeCap>100MB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern>${FILE_LOG_PATTERN}</pattern>
			<charset>${FILE_LOG_CHARSET}</charset>
		</encoder>
	</appender>
	<springProfile name="gtp">
		<root level="INFO">
			<appender-ref ref="FILE"/>
		</root>
	</springProfile>
	<springProfile name="!gtp">
		<root level="INFO">
			<appender-ref ref="STDERR"/>
			<appender-ref ref="FILE"/>
		</root>
	</springProfile>
</configuration>
